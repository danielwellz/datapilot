# Copy to .env and adjust. Every value here is a local-development placeholder;
# never reuse these secrets outside your machine.

# --- Docker Compose (local PostgreSQL) ---
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot
POSTGRES_DB=datapilot

# --- Backend ---
APP_ENV=development
SECRET_KEY=change-me-flask-secret
DATABASE_URL=postgresql+psycopg://datapilot:datapilot@localhost:5433/datapilot
TEST_DATABASE_URL=postgresql+psycopg://datapilot:datapilot@localhost:5433/datapilot_test
# Ask your data runs model-written SQL as this read-only role. The migrations
# create the role; `make db-roles` sets its password from this URL. The role is
# shared by every database of the cluster, so TEST_READONLY_DATABASE_URL must
# use the same password.
READONLY_DATABASE_URL=postgresql+psycopg://datapilot_readonly:change-me-readonly@localhost:5433/datapilot
TEST_READONLY_DATABASE_URL=postgresql+psycopg://datapilot_readonly:change-me-readonly@localhost:5433/datapilot_test
REDIS_URL=redis://localhost:6379/0
# Tests flush this Redis database between tests, so keep it apart from REDIS_URL.
TEST_REDIS_URL=redis://localhost:6379/15
JWT_SECRET_KEY=change-me-jwt-secret-of-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
LOG_LEVEL=INFO
# Reverse proxies in front of the API that append to X-Forwarded-For; 0 when
# clients connect directly (the dev server). The demo stack sets 1 for Nginx.
TRUSTED_PROXY_HOPS=0
# Longest statement a request may run before it is stopped with a 503.
API_STATEMENT_TIMEOUT_MS=3000

# --- Ask your data ---
# Models come from a registry (backend/app/ai/llm_models.toml). A provider's
# models are offered once its API key below is set; with no key at all, the
# app uses a deterministic demo model that answers the example questions.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# A registry model id; empty means the first enabled model in the registry.
LLM_DEFAULT_MODEL=
# Model ids tried in order when a provider fails (rate limit, outage, refused
# key). Empty means one model per provider in turn, in registry order, so a
# fallback always reaches another provider. Models whose provider has no key
# are skipped. With two providers enabled, the app refuses to start if any
# model could only fall back to its own provider.
LLM_FALLBACK_MODELS=
# LLM_MODELS_FILE=/path/to/your-models.toml
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=8192
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_ROWS=1000
AI_STATEMENT_TIMEOUT_MS=5000
